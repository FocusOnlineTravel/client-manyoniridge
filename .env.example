# ==============================================================================
# Manyoni Ridge Safari Lodge - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Data Source Configuration
# ------------------------------------------------------------------------------

# Toggle between local data files and WordPress
# Set to 'true' to use WordPress as the data source
# Set to 'false' or leave empty to use local TypeScript data files
NEXT_PUBLIC_USE_WORDPRESS=false

# WordPress REST API URL (must include /wp/v2)
# Example: https://cms.manyoniridge.co.za/wp-json/wp/v2
NEXT_PUBLIC_WP_API_URL=http://localhost:8000/wp-json/wp/v2

# WordPress REST API namespace (usually wp/v2)
NEXT_PUBLIC_WP_API_NAMESPACE=wp/v2

# ------------------------------------------------------------------------------
# WordPress Authentication (if needed for private content)
# ------------------------------------------------------------------------------

# WordPress Application Password or JWT token
# Only needed if you have private/draft content to fetch
# WP_AUTH_USER=admin
# WP_AUTH_PASSWORD=your_application_password

# ------------------------------------------------------------------------------
# Site Configuration
# ------------------------------------------------------------------------------

# Site URL (used for metadata, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=https://www.manyoniridge.co.za

# Contact email for forms
NEXT_PUBLIC_CONTACT_EMAIL=info@manyoniridge.co.za

# ------------------------------------------------------------------------------
# Analytics & Tracking
# ------------------------------------------------------------------------------

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Facebook Pixel ID
# NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXX

# ------------------------------------------------------------------------------
# Form Submissions
# ------------------------------------------------------------------------------

# Email service configuration (if using external service)
# EMAIL_SERVICE_API_KEY=your_api_key
# EMAIL_SERVICE_ENDPOINT=https://api.emailservice.com/send

# ------------------------------------------------------------------------------
# Image Optimization
# ------------------------------------------------------------------------------

# External image domains (for Next.js Image optimization)
# Add your WordPress media domain here when using WordPress
# NEXT_PUBLIC_IMAGE_DOMAINS=cms.manyoniridge.co.za

# ------------------------------------------------------------------------------
# Development Settings
# ------------------------------------------------------------------------------

# Enable debug logging
# NEXT_PUBLIC_DEBUG=false

# ISR revalidation time (in seconds)
# How often to regenerate static pages in production
# NEXT_PUBLIC_REVALIDATE_TIME=60
