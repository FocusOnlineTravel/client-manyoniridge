# WordPress Data Source Toggle - Enable WordPress as the content source
NEXT_PUBLIC_USE_WORDPRESS=true

# WordPress API Endpoints (these have hardcoded fallbacks, but setting explicitly for clarity)
NEXT_PUBLIC_WP_API_URL=https://content.manyoniridge.com/wp-json/wp/v2
NEXT_PUBLIC_WP_GRAPHQL_URL=https://content.manyoniridge.com/graphql
